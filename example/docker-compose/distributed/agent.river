logging {
  level  = "info"
  format = "logfmt"
}

otelcol.processor.batch "batch" {
  output {
    traces  = [otelcol.exporter.otlphttp.tracestore.input]
  }
}

otelcol.receiver.jaeger "traces" {
  protocols {
    grpc {}
    thrift_http {}
    thrift_binary {}
    thrift_compact {}
  }

  output {
    traces  = [otelcol.processor.batch.batch.input]
  }
}

// Uses HTTP to send traces to Tracestore
// This allows to not use TLS and use basic auth
otelcol.exporter.otlphttp "tracestore" {
  client {
    endpoint = "http://distributor:4318"
    tls {
      insecure = true
    }
  }
}